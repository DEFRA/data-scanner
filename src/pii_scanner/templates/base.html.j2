<!DOCTYPE html>
<html lang="en" class="govuk-template">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{% block title %}Personal data scan{% endblock %} - Personal data scan - {{ org|org_name if org else 'Defra' }}</title>
<link rel="stylesheet" href="{{ root }}assets/report.min.css">
</head>
<body class="govuk-template__body">
<script>document.body.className += ' js-enabled';</script>
<a href="#main-content" class="govuk-skip-link">Skip to main content</a>

<header class="defra-header">
  <div class="defra-header__inner">
    <img src="{{ root }}assets/defra-logo.svg" alt="" role="presentation" class="defra-header__logo">
    <a href="{{ root }}index.html" class="defra-header__service-name">
      <span class="govuk-visually-hidden">Department for Environment, Food and Rural Affairs: </span>Personal data scan{% if org %}: {{ org|org_name }}{% endif %}
    </a>
    <span class="defra-header__classification">OFFICIAL-SENSITIVE</span>
  </div>
</header>
{% if org %}
{% set nav_items = [
  ('summary', 'index.html', 'Summary'),
  ('queue-a', 'queue-a.html', 'Queue A (production/data)'),
  ('queue-b', 'queue-b.html', 'Queue B (tests/docs)'),
  ('new', 'new.html', 'New'),
  ('teams', 'teams.html', 'Teams'),
  ('authors', 'authors.html', 'Authors'),
  ('triaged', 'triaged.html', 'Triaged'),
] %}
<nav class="defra-service-navigation" aria-label="Report navigation">
  <div class="defra-service-navigation__inner">
    <ul class="defra-service-navigation__list">
      {% for key, href, label in nav_items %}
      <li class="defra-service-navigation__item">
        <a class="defra-service-navigation__link" href="{{ root }}{{ href }}"{% if nav == key %} aria-current="page"{% endif %}>{{ label }}</a>
      </li>
      {% endfor %}
    </ul>
  </div>
</nav>
{% endif %}

<div class="app-width-container">
  <div class="govuk-warning-text app-warning">
    <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
    <strong class="govuk-warning-text__text">
      <span class="govuk-visually-hidden">Warning</span>
      OFFICIAL-SENSITIVE: this report contains references to potential personal data. Do not publish, share publicly or commit it.
    </strong>
  </div>
  {% block before_content %}{% endblock %}
  <main class="govuk-main-wrapper" id="main-content">
{% block content %}{% endblock %}
  </main>
</div>

<footer class="defra-footer">
  <div class="app-width-container">
    <div class="defra-footer__meta">
      <ul class="defra-footer__inline-list">
        <li class="defra-footer__inline-list-item"><a class="defra-footer__link" href="{{ root }}index.html">Summary</a></li>
        {% if org %}
        <li class="defra-footer__inline-list-item"><a class="defra-footer__link" href="{{ root }}findings.csv">All findings (CSV)</a></li>
        <li class="defra-footer__inline-list-item"><a class="defra-footer__link" href="{{ root }}findings.json">All findings (JSON)</a></li>
        {% endif %}
      </ul>
      <p class="defra-footer__text govuk-!-margin-0">
        Generated by pii-scan{% if meta.runs %} from scan run {{ meta.runs[0].id }} (finished {{ meta.runs[0].finished_at }}){% endif %}.
        Masked values only. Keep this report on an encrypted, access-controlled device.
      </p>
    </div>
  </div>
</footer>

<script>
(function () {
  var params = new URLSearchParams(window.location.search);
  var applyParams = true;

  document.querySelectorAll('[data-filters-for]').forEach(function (panel) {
    var table = document.getElementById(panel.dataset.filtersFor);
    if (!table) return;
    var rows = Array.from(table.tBodies[0].rows);
    var text = panel.querySelector('[data-filter-text]');
    var selects = Array.from(panel.querySelectorAll('select[data-filter-key]'));
    var count = panel.querySelector('[data-filter-count]');
    var haystack = null;
    var timer = null;

    function apply() {
      var q = text.value.trim().toLowerCase();
      var active = selects.filter(function (s) { return s.value; })
        .map(function (s) { return [s.dataset.filterKey, '|' + s.value + '|']; });
      if (q && !haystack) haystack = rows.map(function (tr) { return tr.textContent.toLowerCase(); });
      var shown = 0;
      rows.forEach(function (tr, i) {
        var ok = !q || haystack[i].indexOf(q) !== -1;
        for (var j = 0; ok && j < active.length; j++) {
          ok = ('|' + (tr.dataset[active[j][0]] || '') + '|').indexOf(active[j][1]) !== -1;
        }
        tr.hidden = !ok;
        if (ok) shown++;
      });
      if (count) count.textContent = 'Showing ' + shown + ' of ' + rows.length;
    }

    function later() { clearTimeout(timer); timer = setTimeout(apply, 150); }
    text.addEventListener('input', later);
    selects.forEach(function (s) { s.addEventListener('change', apply); });
    var clear = panel.querySelector('[data-filter-clear]');
    if (clear) clear.addEventListener('click', function () {
      text.value = '';
      selects.forEach(function (s) { s.value = ''; });
      apply();
    });

    // Links like queue-a.html?band=High&archived=1 preset the first filter panel on the page
    if (applyParams) {
      applyParams = false;
      selects.forEach(function (s) {
        var v = params.get(s.dataset.filterKey);
        if (v && Array.from(s.options).some(function (o) { return o.value === v; })) s.value = v;
      });
      if (params.get('q')) text.value = params.get('q');
    }

    var csvButton = panel.querySelector('[data-filter-csv]');
    if (csvButton) csvButton.addEventListener('click', function () {
      var data = JSON.parse(document.getElementById(csvButton.dataset.filterCsv).textContent);
      var lines = [data.fields.map(csvCell).join(',')];
      Array.from(table.tBodies[0].rows).forEach(function (tr) {
        if (!tr.hidden) lines.push(data.rows[+tr.dataset.i].map(csvCell).join(','));
      });
      var blob = new Blob(['\ufeff' + lines.join('\r\n') + '\r\n'], { type: 'text/csv;charset=utf-8' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = (csvButton.dataset.filename || 'findings') + '-filtered.csv';
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
    });

    apply();
  });

  function csvCell(v) {
    if (v === null || v === undefined) v = '';
    else if (v === true) v = 'True';
    else if (v === false) v = 'False';
    v = String(v);
    // Repo content is untrusted: stop spreadsheet apps interpreting cells as formulas (matches the Python export)
    if (/^[=+\-@\t\r]/.test(v)) v = "'" + v;
    return /[",\r\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v;
  }
})();
document.querySelectorAll('table[data-sortable] thead th').forEach(function (th) {
  var idx = th.cellIndex;
  var label = th.textContent.trim();
  if (!label) return;
  var button = document.createElement('button');
  button.type = 'button';
  button.className = 'app-sort-button';
  button.textContent = label;
  var icon = document.createElement('span');
  icon.className = 'app-sort-button__icon';
  icon.setAttribute('aria-hidden', 'true');
  button.appendChild(icon);
  th.textContent = '';
  th.appendChild(button);
  th.setAttribute('aria-sort', 'none');
  button.addEventListener('click', function () {
    var table = th.closest('table');
    var tbody = table.querySelector('tbody');
    var rows = Array.from(tbody.rows);
    var asc = th.getAttribute('aria-sort') !== 'ascending';
    table.querySelectorAll('thead th').forEach(function (h) { if (h.hasAttribute('aria-sort')) h.setAttribute('aria-sort', 'none'); });
    th.setAttribute('aria-sort', asc ? 'ascending' : 'descending');
    rows.sort(function (a, b) {
      var x = a.cells[idx].dataset.sort || a.cells[idx].textContent.trim();
      var y = b.cells[idx].dataset.sort || b.cells[idx].textContent.trim();
      var nx = parseFloat(x), ny = parseFloat(y);
      var cmp = (!isNaN(nx) && !isNaN(ny)) ? nx - ny : x.localeCompare(y);
      return asc ? cmp : -cmp;
    });
    rows.forEach(function (r) { tbody.appendChild(r); });
  });
});
</script>
</body>
</html>
