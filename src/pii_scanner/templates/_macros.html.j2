{% set band_colours = {'High': 'red', 'Medium': 'orange', 'Low': 'yellow', 'Minimal': 'grey', 'Likely fake': 'green'} %}

{% macro band_tag(band) %}<strong class="govuk-tag govuk-tag--{{ band_colours.get(band, 'grey') }} app-tag--small">{{ band }}</strong>{% endmacro %}

{% macro filter_input(table_id, label, hint=None, selects=[]) %}
{# Text filter plus optional selects; each select matches the row attribute data-<key> ('|' separates multiple values) #}
<div class="app-filters" data-filters-for="{{ table_id }}">
  <div class="govuk-form-group app-filter">
    <label class="govuk-label govuk-label--s" for="filter-{{ table_id }}">{{ label }}</label>
    {% if hint %}<div id="filter-{{ table_id }}-hint" class="govuk-hint">{{ hint }}</div>{% endif %}
    <input class="govuk-input" id="filter-{{ table_id }}" type="search" data-filter-text autocomplete="off" spellcheck="false"{% if hint %} aria-describedby="filter-{{ table_id }}-hint"{% endif %}>
  </div>
  <div class="app-filters__selects">
  {% for key, select_label, options in selects if options|length > 1 or (key == 'new' and options) %}
  <div class="govuk-form-group app-filter app-filter--select">
    <label class="govuk-label govuk-label--s" for="filter-{{ table_id }}-{{ key }}">{{ select_label }}</label>
    <select class="govuk-select" id="filter-{{ table_id }}-{{ key }}" data-filter-key="{{ key }}">
      <option value="">All</option>
      {% for value, text in options %}<option value="{{ value }}">{{ text }}</option>{% endfor %}
    </select>
  </div>
  {% endfor %}
  </div>
  <div class="app-filters__actions">
    <p class="govuk-body app-filters__count" aria-live="polite" data-filter-count></p>
    <button type="button" class="govuk-button govuk-button--secondary" data-filter-clear>Clear filters</button>
    {% if caller %}{{ caller() }}{% endif %}
  </div>
</div>
{% endmacro %}

{% macro findings_table(findings, table_id, show_repo=False, csv_name='findings') %}
{% if findings %}
{% set opts = filter_options(findings) %}
{% set selects = [
  ('band', 'Band', opts.band),
  ('queue', 'Queue', opts.queue),
  ('archived', 'Repository status', opts.archived),
  ('head', 'Default branch', opts.head),
  ('category', 'Type', opts.category),
  ('tier', 'Tier', opts.tier),
  ('source', 'Source', opts.source),
  ('teams', 'Team', opts.teams),
  ('new', 'New since previous run', opts.new),
] %}
{% call filter_input(table_id, 'Filter findings', findings|length ~ ' findings, grouped by repository in priority order. Search by repository, type, author or path. Select a column heading to sort.', selects) %}
    <button type="button" class="govuk-button" data-filter-csv="{{ table_id }}-data" data-filename="{{ csv_name }}">Download filtered CSV</button>
{% endcall %}
<script type="application/json" id="{{ table_id }}-data">{{ {'fields': export_fields, 'rows': findings|map(attribute='export')|list}|tojson }}</script>
<table class="govuk-table app-table--compact" id="{{ table_id }}" data-sortable>
<thead class="govuk-table__head"><tr class="govuk-table__row">
  {% if show_repo %}<th scope="col" class="govuk-table__header govuk-table__header--numeric">Priority</th>{% endif %}
  <th scope="col" class="govuk-table__header">Band</th>
  <th scope="col" class="govuk-table__header govuk-table__header--numeric">Score</th>
  {% if show_repo %}<th scope="col" class="govuk-table__header">Repo</th>{% endif %}
  <th scope="col" class="govuk-table__header">Type</th>
  <th scope="col" class="govuk-table__header">Value (masked)</th>
  <th scope="col" class="govuk-table__header">File</th>
  <th scope="col" class="govuk-table__header">Introduced</th>
  <th scope="col" class="govuk-table__header">Author</th>
  <th scope="col" class="govuk-table__header">Default branch</th>
  <th scope="col" class="govuk-table__header govuk-table__header--numeric">Seen</th>
  <th scope="col" class="govuk-table__header">Why</th>
  <th scope="col" class="govuk-table__header">Triage</th>
</tr></thead>
<tbody class="govuk-table__body">
{% for f in findings %}
<tr class="govuk-table__row" data-i="{{ loop.index0 }}" data-band="{{ f.band }}" data-queue="{{ f.queue }}" data-archived="{{ 1 if f.archived else 0 }}" data-head="{{ head_state(f) }}" data-category="{{ f.category }}" data-tier="{{ f.tier }}" data-source="{{ f.source }}" data-teams="{{ f.team_list|map(attribute='team_name')|join('|') }}" data-new="{{ 1 if f.is_new else 0 }}">
  {% if show_repo %}<td class="govuk-table__cell govuk-table__cell--numeric" data-sort="{{ loop.index0 }}">{{ f.priority }}</td>{% endif %}
  <td class="govuk-table__cell" data-sort="{{ bands.index(f.band) }}">{{ band_tag(f.band) }}
    {% if f.is_new %}<br><strong class="govuk-tag app-tag--small">New</strong>{% endif %}</td>
  <td class="govuk-table__cell govuk-table__cell--numeric">{{ '%.1f'|format(f.score) }}</td>
  {% if show_repo %}
  <td class="govuk-table__cell"><a class="govuk-link" href="{{ root }}repos/{{ repo_slug(f.org, f.repo) }}.html">{{ f.repo }}</a>
    {% if f.archived %}<br><strong class="govuk-tag govuk-tag--grey app-tag--small">Archived</strong>{% endif %}
    {% if f.teams %}<br><span class="govuk-body-s app-muted">{{ f.teams }}</span>{% endif %}</td>
  {% endif %}
  <td class="govuk-table__cell">{{ f.category }}<br><span class="govuk-body-s app-muted">{{ f.tier }}{% if f.source != 'code' %}, {{ f.source }}{% endif %}</span></td>
  <td class="govuk-table__cell"><code>{{ f.masked }}</code></td>
  <td class="govuk-table__cell"><a class="govuk-link" href="{{ f.file_url }}" rel="noopener noreferrer" target="_blank"><code>{{ f.path }}</code></a>
    {% if f.line %}<br><span class="govuk-body-s app-muted">line {{ f.line }}</span>{% endif %}
    {% if f.location %}<br><span class="govuk-body-s app-muted">{{ f.location }}</span>{% endif %}</td>
  <td class="govuk-table__cell" data-sort="{{ f.author_date }}"><a class="govuk-link" href="{{ f.commit_url }}" rel="noopener noreferrer" target="_blank"><code>{{ f.commit_sha[:10] }}</code></a><br>
    <span class="govuk-body-s app-muted">{{ (f.author_date or '')[:10] }}</span></td>
  <td class="govuk-table__cell">{{ f.author_name }}
    {% if f.github_login %}<br><a class="govuk-link" href="https://github.com/{{ f.github_login }}" rel="noopener noreferrer" target="_blank">@{{ f.github_login }}</a>{% endif %}</td>
  <td class="govuk-table__cell">{% if f.in_head %}<strong>Still present</strong>{% elif f.in_head == 0 %}History only{% else %}Unknown{% endif %}</td>
  <td class="govuk-table__cell govuk-table__cell--numeric">{{ f.occurrences }}</td>
  <td class="govuk-table__cell"><details class="govuk-details">
    <summary class="govuk-details__summary"><span class="govuk-details__summary-text">{{ f.reasons|length }} factors</span></summary>
    <div class="govuk-details__text"><ul class="govuk-list govuk-list--bullet govuk-body-s">
    {% for r in f.reasons %}<li>{{ r }}</li>{% endfor %}</ul></div></details></td>
  <td class="govuk-table__cell">{% if f.triage_status %}<strong class="govuk-tag govuk-tag--grey app-tag--small">{{ f.triage_status }}</strong>{% if f.triage_note %}<br><span class="govuk-body-s app-muted">{{ f.triage_note }}</span>{% endif %}<br>{% endif %}
    <span class="govuk-body-s app-muted"><code>{{ f.fingerprint[:12] }}</code></span></td>
</tr>
{% endfor %}
</tbody>
</table>
{% else %}
<p class="govuk-body">None.</p>
{% endif %}
{% endmacro %}
