{% extends "base.html.j2" %}
{% from "_macros.html.j2" import findings_table with context %}
{% block title %}{{ group.label }}{% endblock %}
{% block before_content %}
<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
  <ol class="govuk-breadcrumbs__list">
    <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="{{ root }}index.html">Summary</a></li>
    <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="{{ root }}{{ kind }}.html">{{ 'Teams' if kind == 'teams' else 'Authors' }}</a></li>
  </ol>
</nav>
{% endblock %}
{% block content %}
<span class="govuk-caption-l">{{ 'Team' if kind == 'teams' else 'Author' }}</span>
<h1 class="govuk-heading-xl">{{ group.label }}</h1>
<p class="govuk-body">
  {% if kind == 'teams' %}Team with write, maintain or admin access.{% else %}First committed the findings below.
  {% if group.key.startswith('@') %}<a class="govuk-link" href="https://github.com/{{ group.key[1:] }}" rel="noopener noreferrer" target="_blank">GitHub profile</a>.{% endif %}{% endif %}
  <a class="govuk-link" href="{{ root }}exports/{{ kind }}/{{ group.slug }}.csv">Download these findings as CSV</a>.
</p>
<p class="govuk-body">Repositories ({{ group.repos|length }}):
  {% for r in group.repos %}<a class="govuk-link" href="{{ root }}repos/{{ repo_slug(findings[0].org, r) }}.html">{{ r }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>

<h2 class="govuk-heading-l">Queue A: production code, data files and wikis</h2>
{{ findings_table(findings|selectattr('queue', 'equalto', 'A')|list, 'qa', show_repo=True) }}

<h2 class="govuk-heading-l">Queue B: tests, fixtures and docs</h2>
{{ findings_table(findings|selectattr('queue', 'equalto', 'B')|list, 'qb', show_repo=True) }}
{% endblock %}
